{
  "name": "enterprise-web-platform",
  "private": true,
  "version": "9.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:owner": "VITE_WORKSPACE_SLOT=owner VITE_STRICT_PORT=1 VITE_DEV_ROLE_SWITCHER=true PORT=3000 vite --port 3000",
    "dev:travel": "VITE_WORKSPACE_SLOT=travel VITE_STRICT_PORT=1 PORT=3001 vite --port 3001",
    "dev:crypto": "VITE_WORKSPACE_SLOT=crypto VITE_STRICT_PORT=1 PORT=3002 vite --port 3002",
    "dev:build": "VITE_WORKSPACE_SLOT=build VITE_STRICT_PORT=1 PORT=3003 vite --port 3003",
    "dev:drone": "VITE_WORKSPACE_SLOT=drone VITE_STRICT_PORT=1 PORT=3004 vite --port 3004",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "audit:i18n": "node scripts/localization_audit.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.101.2",
    "chart.js": "^4.5.1",
    "lightweight-charts": "^4.2.0",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.55.0",
    "react-router-dom": "^7.18.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.170.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "@playwright/test": "^1.55.0"
  }
}
