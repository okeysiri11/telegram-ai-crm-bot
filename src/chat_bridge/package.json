{
  "name": "@ados/chat-bridge",
  "private": true,
  "version": "4.0.0",
  "description": "ADOS ChatGPT Integration Bridge — middleware between ChatGPT and Cursor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ados/orchestrator": "file:../orchestrator",
    "@ados/providers": "file:../providers"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
