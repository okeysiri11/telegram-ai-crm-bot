5\u0414 \u0434\u043b\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u043d\u0438\u0445 \u043f\u043e\u0442\u0440\u0435\u0431 \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454 \u0434\u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0456\u0447\u043d\u0438\u0445 \u043f\u0440\u0430\u0432\u0438\u043b, \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438 \u043a\u043b\u0430\u0441\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u0457 \u0442\u0430 \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0445 \u043c\u0435\u0436 \u043c\u0456\u0436 \u043f\u043e\u0437\u0438\u0446\u0456\u044f\u043c\u0438, \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043d\u0438\u0445 \u0437\u0432\u2019\u044f\u0437\u043a\u0456\u0432 \u043c\u0456\u0436 \u043a\u043b\u0430\u0441\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u044f\u043c\u0438 \u0434\u0456\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u0456, \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0456\u0457 \u0442\u0430 \u0442\u043e\u0432\u0430\u0440\u0456\u0432 \u0437\u043e\u0432\u043d\u0456\u0448\u043d\u044c\u043e\u0435\u043a\u043e\u043d\u043e\u043c\u0456\u0447\u043d\u043e\u0457 \u0434\u0456\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u0456, \u043c\u0435\u0442\u043e\u0434\u0443 \u201c\u0437\u0432\u0435\u0440\u0445\u0443-\u0432\u043d\u0438\u0437\u201d (top-down) \u0449\u043e\u0434\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433\u043e \u0432\u0438\u0434\u0443 \u0434\u0456\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u0456, \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u044c \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u043d\u0438\u0445 \u043e\u0434\u0438\u043d\u0438\u0446\u044c \u0442\u043e\u0449\u043e. \u041d\u0430\u043a\u0430\u0437 \u0414\u0435\u0440\u0436\u0441\u043f\u043e\u0436\u0438\u0432\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u0443 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u0432\u0456\u0434 11.10.2010 \u0440. \u2116 457 (\u0456\u0437 \u0437\u043c\u0456\u043d\u0430\u043c\u0438, \u0432\u043d\u0435\u0441\u0435\u043d\u0438\u043c\u0438 \u043d\u0430\u043a\u0430\u0437\u043e\u043c \u0414\u0435\u0440\u0436\u0441\u043f\u043e\u0436\u0438\u0432\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u0443 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u0432\u0456\u0434 29 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2010 \u2116 530).\r\n\u0417\u043c\u0456\u043d\u0430 \u21161  \u0434\u043e \u0414\u041a 009:2010  \u00ab\u041a\u043b\u0430\u0441\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u044f \u0432\u0438\u0434\u0456\u0432 \u0435\u043a\u043e\u043d\u043e\u043c\u0456\u0447\u043d\u043e\u0457 \u0434\u0456\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u0456\u00bb  \u0437\u0430\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u0430  \u043d\u0430\u043a\u0430\u0437\u043e\u043c \u041c\u0456\u043d\u0435\u043a\u043e\u043d\u043e\u043c\u0440\u043e\u0437\u0432\u0438\u0442\u043a\u0443 \u0432\u0456\u0434 24.02.2020 \u2116 306 http://www.ukrstat.gov.ua/klasf/nac_kls/zmina_1%20dc_009.zip,  \u0437\u0456 \u0437\u043c\u0456\u043d\u0430\u043c\u0438 (\u043d\u0430\u043a\u0430\u0437 \u041c\u0456\u043d\u0435\u043a\u043e\u043d\u043e\u043c\u0456\u043a\u0438 \u0432\u0456\u0434 04.01.2023 \u2116 47)", "owner_org": "51d6e1af-8754-41e3-8405-66a49cc74e11", "license_url": "http://www.opendefinition.org/licenses/cc-by", "title": "\u041a\u043b\u0430\u0441\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u044f \u0432\u0438\u0434\u0456\u0432 \u0435\u043a\u043e\u043d\u043e\u043c\u0456\u0447\u043d\u043e\u0457 \u0434\u0456\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u0456 (\u041a\u0412\u0415\u0414)", "revision_id": "6e09b77e-a387-483a-ba2d-2392ff92b1a3"}], "search_facets": {}}}