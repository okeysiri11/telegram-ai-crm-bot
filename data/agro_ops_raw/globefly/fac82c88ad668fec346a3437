a\u041f \u043f\u043e\u043b\u044f\u0433\u0430\u0454 \u0432 \u043e\u043f\u0438\u0441\u0456 \u0442\u0430 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443\u0432\u0430\u043d\u043d\u0456 \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0456\u0457, \u044f\u043a\u0430 \u0431\u0443\u043b\u0430 \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u0430 \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0456 \u0437\u0434\u0456\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u0432\u0438\u0434\u0456\u0432 \u0435\u043a\u043e\u043d\u043e\u043c\u0456\u0447\u043d\u043e\u0457 \u0434\u0456\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u0456. \u041a\u043e\u0434 \u0432\u0438\u0434\u0443 \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0456\u0457 \u043d\u0430 \u0440\u0456\u0432\u043d\u0456 \u043a\u043b\u0430\u0441\u0443 (4 \u0437\u043d\u0430\u043a\u0438 \u043a\u043e\u0434\u0443) \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u0454 \u043a\u043e\u0434\u0443 \u0432\u0438\u0434\u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0456\u0447\u043d\u043e\u0457 \u0434\u0456\u044f\u043b\u044c\u043d\u043e\u0441\u0442\u0456 \u0437\u0430 \u041a\u0412\u0415\u0414-2010.\r\n\u0421\u041a\u041f \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u043f\u043e\u0434\u0456\u043b\u0443 \u0434\u0430\u043d\u0438\u0445 \u0437\u0430 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0456\u044f\u043c\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0446\u0456\u0457, \u044f\u043a\u0430 \u043c\u0430\u0454 \u0441\u043f\u0456\u043b\u044c\u043d\u0456 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438.\r\n\u0421\u041a\u041f \u0454 \u043e\u0441\u043d\u043e\u0432\u043e\u044e \u0434\u043b\u044f \u043f\u0456\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u043d\u0438\u0445 \u0434\u0430\u043d\u0438\u0445 \u0449\u043e\u0434\u043e \u0432\u0438\u0440\u043e\u0431\u043d\