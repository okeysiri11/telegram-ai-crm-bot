# Copy to .env and fill in values.

BOT_TOKEN=
OPENROUTER_API_KEY=

# PostgreSQL (SQLAlchemy 2 async + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_ecosystem

# Production: PostgreSQL only (disables SQLite bootstrap)
POSTGRES_ONLY=true

# Environment (production requires Redis for FSM)
ENVIRONMENT=development
# ENVIRONMENT=production

# Redis FSM — required when POSTGRES_ONLY=true or ENVIRONMENT=production
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# Legacy discrete vars (optional fallback)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_ecosystem
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# HTTP API (health checks)
API_HOST=0.0.0.0
API_PORT=8080

# Platform IAM (Management API — required in all environments)
IAM_JWT_SECRET=
JWT_SECRET=
API_JWT_SECRET=
IAM_LOGIN_SECRET=

# Grafana (docker compose)
GRAFANA_ADMIN_USER=ados_admin
GRAFANA_ADMIN_PASSWORD=admin

# n8n sidecar (docker-compose.n8n.yml) — set before enabling --profile n8n
N8N_ENCRYPTION_KEY=

# Sprint 30.0 security governance
# SECURITY_MASTER_KEY=  # required in production
# ALLOW_HEADER_AUTH=false  # default false in production; true in development
# REQUIRE_TENANT_FILTER=true
# RATE_LIMIT_ENABLED=true
# SECURITY_HEADERS_ENABLED=true
# CSRF_PROTECTION_ENABLED=false

# Sprint 30.1 — Google Sign-In (preferred Beta auth)
# GOOGLE_CLIENT_ID=  # required for production Google ID token verification
# Without GOOGLE_CLIENT_ID, only google_demo_* local credentials work (non-production)

# Operations Center login proof (must match IAM_LOGIN_SECRET in dev)
# VITE_IAM_LOGIN_SECRET=

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Platform Telegram user ids
OWNER_ID=1208044579
DEFAULT_AUTO_MANAGER_ID=393792086
DEFAULT_DEALER_MANAGER_ID=8312013093
# AGRO manager (Christopher Moltisanti) — set Telegram id for agro lead routing
DEFAULT_AGRO_MANAGER_ID=
# REALTY manager (Luc) — set Telegram id for realty lead routing
DEFAULT_REALTY_MANAGER_ID=
# Optional display names for MANAGERS registry
# DEFAULT_AUTO_MANAGER_NAME=Борода
# DEFAULT_AGRO_MANAGER_NAME=Christopher Moltisanti
# DEFAULT_REALTY_MANAGER_NAME=Luc
# DEFAULT_DEALER_MANAGER_NAME=Tony

# Dynamic manager pool assignment: ROUND_ROBIN | LEAST_LOADED | WEIGHTED | PRIORITY
MANAGER_ASSIGNMENT_MODE=ROUND_ROBIN

# Smart assignment engine (primary): SMART | ROUND_ROBIN | LEAST_LOADED | PRIORITY | WEIGHTED
ASSIGNMENT_MODE=SMART
SMART_ASSIGNMENT_LOAD_WEIGHT=0.40
SMART_ASSIGNMENT_RESPONSE_WEIGHT=0.25
SMART_ASSIGNMENT_COMPLETED_WEIGHT=0.15
SMART_ASSIGNMENT_PRIORITY_WEIGHT=0.10
SMART_ASSIGNMENT_SPECIALIZATION_WEIGHT=0.10

# Auto Marketing Engine — Telegram channel for publications
MARKETING_TELEGRAM_CHANNEL_ID=

# Automotive Treasury / Dealer Quote Authority — Foma Rates channel (authoritative)
# Automotive Treasury / BidEx @bidex_Odesa — authoritative dealer FX rates
BIDEX_TELEGRAM_CHANNEL_USERNAME=bidex_Odesa
BIDEX_TELEGRAM_CHANNEL_ID=
# Legacy Foma Rates channel (optional fallback)
FOMA_RATES_TELEGRAM_CHANNEL_ID=
DEALER_RATES_TELEGRAM_CHANNEL_ID=
